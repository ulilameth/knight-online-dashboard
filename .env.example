# Kopyala: cp .env.example .env.local

# Veri kaynağı: demo (varsayılan; Supabase gerekmez, örnek verilerle bellekte çalışır) ya da supabase
DATA_SOURCE=demo

# Yalnızca demo: açılış sonrası ekranları görmek için şimdiki zamanı değiştir (TSİ), ör. 2026-11-21T19:40
# DEMO_SIMDI=

# DATA_SOURCE=supabase için (Supabase › Project Settings › API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Gizli: yalnızca sunucuda (Vercel ortam değişkeni). Kayıt, giriş ve şifre sıfırlamada kullanılır.
SUPABASE_SERVICE_ROLE_KEY=

# Kayıt adımları arasındaki davet çerezini imzalar; en az 32 karakter rastgele (openssl rand -base64 32)
KAYIT_IMZA_ANAHTARI=
